{
  "name": "wiki-plugin-lexon",
  "version": "0.2.0",
  "description": "Lexon contract source item \u2014 interactive syntax highlighting with clickable clause and term links and switchable emphasis lenses; a modern face with Compile, Scenarios and Permissions tabs; and a fedwiki.api door that compiles a page's contract with the Lexon JavaScript target and runs its behaviour table",
  "type": "module",
  "main": "client/lexon.js",
  "files": [
    "client",
    "pages",
    "api",
    "src/server",
    "src/client",
    "factory.json"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "keywords": "node tools/gen-keywords.mjs",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1"
  },
  "author": "David Bovill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-lexon.git"
  },
  "bugs": {
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-lexon/issues"
  },
  "homepage": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-lexon#readme",
  "fedwiki": {
    "api": {
      "version": 1,
      "spec": "api/openapi.json",
      "handlers": "api/handlers.js"
    }
  }
}
